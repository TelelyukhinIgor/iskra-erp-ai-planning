{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/iskra/schemas/routing-card.schema.json",
  "title": "RoutingCard",
  "description": "Draft or approved routing for one manufactured item. Human approval is mandatory before shop release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "itemId", "status", "operations"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "description": "Manufactured item this routing applies to."
    },
    "revision": {
      "type": "string",
      "description": "Engineering or planning revision label."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "rejected"],
      "description": "Human-in-the-loop lifecycle state."
    },
    "approvedBy": {
      "type": "string",
      "description": "Reviewer identity once approved (opaque)."
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Approval timestamp (ISO-8601)."
    },
    "uncertainSpots": {
      "type": "array",
      "description": "Places the system flagged for mandatory human check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "operationId": { "type": "string" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered production operations.",
      "items": { "$ref": "production-operation.schema.json" }
    },
    "bomLines": {
      "type": "array",
      "description": "Optional embedded BOM lines for the same item.",
      "items": { "$ref": "bom-line.schema.json" }
    }
  }
}
