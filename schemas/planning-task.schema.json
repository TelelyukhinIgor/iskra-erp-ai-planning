{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/iskra/schemas/planning-task.schema.json",
  "title": "PlanningTask",
  "description": "A task issued to a plant function after a planning run. Generic evaluation schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "orderId", "function", "title", "status", "priority"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "description": "Customer or production order reference."
    },
    "function": {
      "type": "string",
      "enum": [
        "sales",
        "engineering",
        "process_engineering",
        "production",
        "procurement",
        "warehouse",
        "quality",
        "finance",
        "hr",
        "leadership"
      ],
      "description": "Receiving plant function."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "assigned", "done", "cancelled"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "critical"]
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "Calendar due date (YYYY-MM-DD)."
    },
    "relatedItemIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional related item identifiers."
    },
    "requiresAcknowledgement": {
      "type": "boolean",
      "description": "If true, a named role must acknowledge before the task is considered accepted."
    }
  }
}
